APP_NAME="QualityPilot API"
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
DATABASE_URL=postgresql+asyncpg://qualitypilot:qualitypilot_dev_password@localhost:5432/qualitypilot
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
UPLOAD_DIRECTORY=../data/uploads
MAX_UPLOAD_SIZE=20971520
DOCUMENT_CHUNK_SIZE=800
DOCUMENT_CHUNK_OVERLAP=100

DASHSCOPE_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=10
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=2
EMBEDDING_RETRY_BASE_DELAY_SECONDS=0.5

# dashscope 保留百炼请求格式；openai_compatible 用于自部署 Qwen2.5。
GENERATION_PROVIDER=dashscope
# 独立的生成服务密钥；只有 dashscope 模式允许留空并复用 DASHSCOPE_API_KEY。
GENERATION_API_KEY=
GENERATION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
GENERATION_MODEL=qwen3.7-max-2026-05-20
GENERATION_TIMEOUT_SECONDS=60
GENERATION_MAX_RETRIES=2
GENERATION_RETRY_BASE_DELAY_SECONDS=0.5
GENERATION_MAX_COMPLETION_TOKENS=1200
# 自部署配置（在本地 .env 修改以上对应项，勿提交真实密钥）：
# GENERATION_PROVIDER=openai_compatible
# GENERATION_BASE_URL=http://127.0.0.1:18001/v1
# GENERATION_MODEL=pcb-qwen-lora
# GENERATION_TIMEOUT_SECONDS=120
# GENERATION_MAX_RETRIES=0
# 18001 是 WSL SSH 隧道端口，转发至云服务器 127.0.0.1:8001。
# 此模式把 GENERATION_MAX_COMPLETION_TOKENS 映射为请求中的 max_tokens。

HYBRID_CANDIDATE_MULTIPLIER=5
HYBRID_RRF_K=60

AGENT_CHECKPOINT_POOL_MIN_SIZE=1
AGENT_CHECKPOINT_POOL_MAX_SIZE=5
AGENT_BUSINESS_TOOL_LIMIT=10
AGENT_BUSINESS_TOOL_TIMEOUT_SECONDS=5
AGENT_APPROVAL_AUTH_REQUIRED=false
AGENT_APPROVAL_API_KEY_SHA256=
AGENT_APPROVAL_ACTOR_ID=
AGENT_APPROVAL_API_KEY_ROLES=quality_approver,alert_operator,alert_viewer,retention_operator,retention_reader
AGENT_OIDC_ENABLED=false
AGENT_OIDC_ISSUER=
AGENT_OIDC_AUDIENCE=
AGENT_OIDC_JWKS_URL=
AGENT_OIDC_ROLES_CLAIM=roles
AGENT_OIDC_LEEWAY_SECONDS=30
AGENT_OIDC_JWKS_CACHE_SECONDS=300
AGENT_OIDC_HTTP_TIMEOUT_SECONDS=5
OBSERVABILITY_METRICS_ENABLED=true
OBSERVABILITY_REQUEST_LOGS_ENABLED=true
AGENT_ERROR_ALERT_THRESHOLD=5
AGENT_ALERT_WEBHOOK_URL=
AGENT_ALERT_WEBHOOK_BEARER_TOKEN=
AGENT_ALERT_DELIVERY_TIMEOUT_SECONDS=10
AGENT_ALERT_LEASE_SECONDS=60
AGENT_ALERT_MAX_ATTEMPTS=5
AGENT_ALERT_RETRY_BASE_DELAY_SECONDS=5
AGENT_ALERT_RETRY_MAX_DELAY_SECONDS=300
AGENT_ALERT_SCHEDULER_ENABLED=false
AGENT_ALERT_SCHEDULER_INTERVAL_SECONDS=60
AGENT_ALERT_SCHEDULER_WINDOW_HOURS=24
AGENT_ALERT_SCHEDULER_BATCH_SIZE=10
AGENT_CHECKPOINT_RETENTION_DAYS=30
AGENT_CHECKPOINT_ARCHIVE_PREVIEW_LIMIT=100
